# Copy to .env and fill in the keys you need.
# In vivo (src/In_vivo_benchmark): Anthropic, OpenAI, Google, OpenRouter.
# In vitro (src/In_vitro_experiments): Google (the judge, gemini-2.5-flash: needed to score any training run),
#   Anthropic (narrative generation, RSS), OpenAI (GPT-4.1 fine-tuning), HF_TOKEN (gated Llama weights).
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
HF_TOKEN=your_huggingface_token
